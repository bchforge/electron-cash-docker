# Electron Cash Docker
# The product version is read from VERSION at image build/runtime.
EC_VERSION=4.4.6
EC_COMMIT=9d500949b38dd181a986382eb0c2f6061b829fec
EC_ARCHIVE_SHA256=fc21dbae10055dee5e4f11a936691576059b40b85107b701221a54c744abd7b7
NOVNC_VERSION=1.6.0
NOVNC_COMMIT=a8dfd6a3ea3c74244f5ebdaa5a7f1023007a7820
NOVNC_ARCHIVE_SHA256=ebb8eabcd3670ce1a02e4025f03976826c289121cf631183647bd8325b003403

# Tor is built locally from the official Tor Project source release.
TOR_VERSION=0.4.9.11
TOR_SOURCE_SHA256=2e6c1720118c812acf0079fd47cf91b6bfaba5d766c321c4d3d2a28d6a11a8ed

# Wallet data is stored in the Docker-managed volume named
# bchforge-electron-cash-data.

# Caddy is the only user-facing web gateway. Local HTTP needs no certificate.
# For public deployment set CADDY_SITE_ADDRESS to the public hostname and set
# CADDY_EDGE_BIND=0.0.0.0, CADDY_HTTP_HOST_PORT=80, and
# CADDY_HTTPS_HOST_PORT=443 after configuring DNS/firewall access.
CADDY_SITE_ADDRESS=localhost
CADDY_TLS_MODE=auto
CADDY_EDGE_BIND=127.0.0.1
CADDY_HTTP_HOST_PORT=80
CADDY_HTTPS_HOST_PORT=443
# Public example:
# CADDY_SITE_ADDRESS=ecd.example.com
# CADDY_TLS_MODE=auto
# CADDY_EDGE_BIND=0.0.0.0
# CADDY_HTTP_HOST_PORT=80
# CADDY_HTTPS_HOST_PORT=443
# DNS A/AAAA -> this server's public IP; allow TCP 80/443.
# Optional local trusted-proxy simulation override. Leave empty in normal
# deployments; the pinned Cloudflare CIDR files are used.
CADDY_TRUSTED_PROXIES=

# Runtime mode: novnc (normal GUI/browser mode) or headless.
MODE=novnc

# JSON-RPC is disabled by default. Enable it only with the explicit
# docker-compose.rpc.yml override and non-empty credentials in this ignored file.
JSONRPC_ENABLED=false
JSONRPC_USER=electroncash
JSONRPC_PASSWORD=
JSONRPC_PORT=50001
JSONRPC_HOST_PORT=50001

# Tor is enabled for Electron Cash traffic by default.
USE_TOR=true

# CashFusion
#
# CashFusion is available by default; automatic fusion remains opt-in.
#
# When enabled for a wallet for the first time, the settings below are used as
# initial defaults. Once a setting exists in Electron Cash, changes made from
# the Electron Cash UI are preserved across restarts.
CASHFUSION_ENABLED=true

# Start automatic fusion when CashFusion is enabled. The default keeps manual
# CashFusion available without starting automatic fusion activity.
CASHFUSION_AUTO_FUSE=false

# Wallet fusion mode.
CASHFUSION_FUSION_MODE=custom

# Number of fusion rounds (0 means unlimited in Electron Cash).
CASHFUSION_FUSE_DEPTH=3

# Number of participations from this wallet in the same fusion round.
# 1 corresponds to "Self-Fusing: No".
CASHFUSION_SELF_FUSE_PLAYERS=1

# Auto-Fusion coin-selection strategy:
#   count:    target number of coins in wallet
#   size:     target typical output amount
#   fraction: per-coin random chance
CASHFUSION_SELECTOR_MODE=count

# Used when CASHFUSION_SELECTOR_MODE=count.
CASHFUSION_SELECTOR_COUNT=10

# Used when CASHFUSION_SELECTOR_MODE=size. Amount expressed in BCH.
CASHFUSION_SELECTOR_SIZE_BCH=0.0001

# Used when CASHFUSION_SELECTOR_MODE=fraction. Fraction from 0.0 to 1.0.
# 1.0 = 100%, 0.5 = 50%, etc.
CASHFUSION_SELECTOR_FRACTION=1.0

# Maximum number of queued automatic fusions.
CASHFUSION_QUEUED_AUTOFUSE=4

# Only start automatic fusions when all wallet coins are confirmed.
CASHFUSION_AUTOFUSE_CONFIRMED_ONLY=true

# The gateway is mandatory and always requires the isolated session login.
# Set BASIC_AUTH_PASSWORD to a real password in .env before startup. This
# example intentionally leaves it empty so Compose fails before containers are
# created until you configure it. Older CHANGE_ME... values are rejected by
# auth-session as a second safeguard. Login is password-only; legacy username
# settings are ignored. The password is passed
# only to auth-session and is never written to Caddy's generated configuration.
# If a password contains '$', write it as '$$' in this Compose dotenv file so the
# literal character reaches the container.
CADDY_IMAGE=electron-cash-docker-caddy:0.3
BASIC_AUTH_PASSWORD=
FAIL2BAN_MAXRETRY=5
FAIL2BAN_FINDTIME=600
FAIL2BAN_BANTIME=3600
FAIL2BAN_IGNOREIP=127.0.0.0/8 ::1

# Testnet4-only automated wallet setup. Never place a production password here.
WALLET_AUTO_CREATE=false
TEST_WALLET_PASSWORD=

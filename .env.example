# Electron Cash Docker v0.2
# Update each version together with its integrity pins.
EC_VERSION=4.4.6
EC_COMMIT=9d500949b38dd181a986382eb0c2f6061b829fec
EC_ARCHIVE_SHA256=fc21dbae10055dee5e4f11a936691576059b40b85107b701221a54c744abd7b7
NOVNC_VERSION=1.6.0
NOVNC_COMMIT=a8dfd6a3ea3c74244f5ebdaa5a7f1023007a7820
NOVNC_ARCHIVE_SHA256=ebb8eabcd3670ce1a02e4025f03976826c289121cf631183647bd8325b003403

# Tor is built locally from the official Tor Project source release.
TOR_VERSION=0.4.9.11
TOR_SOURCE_SHA256=2e6c1720118c812acf0079fd47cf91b6bfaba5d766c321c4d3d2a28d6a11a8ed

# Wallet data is stored in the Docker-managed volume named
# bchforge-electron-cash-data.

# noVNC is localhost-only by default.
NOVNC_BIND=127.0.0.1
NOVNC_HOST_PORT=6080

# Runtime mode: novnc (normal GUI/browser mode) or headless.
MODE=novnc

# JSON-RPC is disabled by default. Enable it only with the explicit
# docker-compose.rpc.yml override and non-empty credentials in this ignored file.
JSONRPC_ENABLED=false
JSONRPC_USER=electroncash
JSONRPC_PASSWORD=
JSONRPC_PORT=50001
JSONRPC_HOST_PORT=50001

# Tor is enabled for Electron Cash traffic by default.
USE_TOR=true

# The CashFusion plugin is enabled by default. Set false to remove its wallet UI
# and prevent all fusion activity.
CASHFUSION_ENABLED=true

# Auto-fuse is opt-in. When true, Electron Cash applies it as each wallet opens;
# encrypted wallets still require their normal password prompt.
CASHFUSION_AUTO_FUSE=false

# Testnet4-only automated wallet setup. Never place a production password here.
WALLET_AUTO_CREATE=false
TEST_WALLET_PASSWORD=

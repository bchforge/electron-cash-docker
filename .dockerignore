# The image only copies files from docker/. Keep wallets, environment files, and
# repository metadata out of every build context.
**
!docker/
!docker/Dockerfile
!docker/novnc-index.html
!docker/novnc-keepalive.js
!docker/entrypoint.sh
!docker/cashfusion.sh
!docker/cashfusion_autofuse.py
!docker/electroncash-wrapper.py
!docker/electroncash-daemon-wrapper.py
!docker/plugins/
!docker/plugins/build_plugins.sh
!plugins.json
!requirements.txt

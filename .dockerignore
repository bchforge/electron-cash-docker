# Keep wallets, environment files, repository metadata, and unrelated project
# files out of the root build context while retaining the Docker assets needed
# by the images.
**
!docker/
!docker/**
!plugins.json
!requirements.txt
!VERSION

# Do not send generated files or nested environment files in the Docker tree.
docker/**/__pycache__/
docker/**/*.pyc
docker/**/.env

# Exclude local secrets and runtime artifacts without narrowing the Docker
# asset allowlist above. Public Tor verification keys use .asc and stay allowed.
docker/**/.env*
docker/**/*.env
docker/**/*.pem
docker/**/*.key
docker/**/*.p12
docker/**/*.pfx
docker/**/*.p8
docker/**/*.ppk
docker/**/*.jks
docker/**/*.private
docker/**/*.private.*
docker/**/id_rsa
docker/**/id_ed25519
docker/**/id_*
docker/**/.netrc
docker/**/.htpasswd
docker/**/credentials/
docker/**/credentials.*
docker/**/secrets/
docker/**/secrets.*
docker/**/*secret*
docker/**/*token*
docker/**/*cookie*
docker/**/*.sqlite*
docker/**/*.sqlite3*
docker/**/*.db
docker/**/*.db-*
docker/**/*.wal
docker/**/*.shm
docker/**/*.journal
docker/**/sessions.sqlite*
docker/**/session/
docker/**/sessions/
docker/**/log/
docker/**/logs/
docker/**/*.log
docker/**/*.log.*
docker/**/backup/
docker/**/backups/
docker/**/*.bak
docker/**/*.backup
docker/**/.cache/
docker/**/cache/
docker/**/.pytest_cache/
docker/**/.mypy_cache/
docker/**/.ruff_cache/
docker/**/*.pyo
docker/**/.DS_Store
docker/**/tmp/
docker/**/temp/
docker/**/*.tmp
docker/**/*.temp
docker/**/*.swp
docker/**/*.swo
docker/**/*.orig
docker/**/*.rej
docker/**/*~

# Required public Tor Project verification key.
!docker/tor/tor-release-keys.asc

# Python bytecode and local OS/editor artifacts.
**/__pycache__/
**/*.pyc
**/*.pyo
**/.DS_Store

# Local environment, secret, runtime, and temporary artifacts.
**/.env*
**/*.env
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.p8
**/*.ppk
**/*.jks
**/*.private
**/*.private.*
**/id_rsa
**/id_ed25519
**/id_*
**/.netrc
**/.htpasswd
**/credentials/
**/credentials.*
**/secrets/
**/secrets.*
**/*secret*
**/*token*
**/*cookie*
**/*.sqlite*
**/*.sqlite3*
**/*.db
**/*.db-*
**/*.wal
**/*.shm
**/*.journal
**/sessions.sqlite*
**/session/
**/sessions/
**/log/
**/logs/
**/*.log
**/*.log.*
**/backup/
**/backups/
**/*.bak
**/*.backup
**/tmp/
**/temp/
**/*.tmp
**/*.temp
**/*.swp
**/*.swo
**/*.orig
**/*.rej
**/*~
